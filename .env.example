# Mukoko mobile env vars. Copy to `.env` and fill in.
# Anything prefixed EXPO_PUBLIC_ is inlined into the JS bundle at build time —
# do NOT put secrets here. Server-side secrets live on the API, never here.

# Base URL of the weather API. It must be a Cloudflare host: the app only ever
# talks to the Cloudflare backend (weather-api.mukoko.com today, api.mukoko.com
# once it has DNS), never to a website's server and never to a database. A value
# on any other host is ignored and the default is used. Leave it as is.
#
# For local development against a Worker on your own machine
# (`wrangler dev` in mukoko-dev/mukoko-weather), development builds also accept
# an address on your own network:
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:8787
EXPO_PUBLIC_API_URL=https://weather-api.mukoko.com

# WorkOS AuthKit hosted page (used by expo-auth-session for sign-in). Sign-in
# is switched off until the API has a route to exchange the code for a session.
# Get these values from the WorkOS dashboard. The client ID is public-safe;
# the secret stays on the server.
EXPO_PUBLIC_WORKOS_CLIENT_ID=client_REPLACE_ME
EXPO_PUBLIC_WORKOS_AUTHKIT_DOMAIN=https://auth.mukoko.com
